# ============================================================
# Govi - Root .gitignore
# Covers: HarmonyOS / ArkTS / DevEco Studio / ArkUI-X
#         Node / ohpm / IDE / OS / Secrets
# ============================================================

# ── Dependencies ──────────────────────────────────────────
node_modules/
oh_modules/
oh_modules/.ohpm/
.pnp/
.pnp.js
.npm/
.yarn/
.pnpm-store/

# ohpm / hvigor lock - keep lock files (oh-package-lock.json5)
# uncomment next line if you want to ignore lock files
# oh-package-lock.json5

# ── Build outputs ─────────────────────────────────────────
build/
**/build/
dist/
out/
.preview/
.cxx/
.test/
.appanalyzer/
hvigor/
.hvigor/
**/.hvigor/
# ArkUI-X build cache
.arkui-x/build/
.arkui-x/.gradle/

# HAP / APP outputs
*.hap
*.hsp
*.app

# ── HarmonyOS / DevEco local config ───────────────────────
local.properties
**/local.properties
keystore.p12
*.p12
*.jks
*.keystore
signing-config.json5
# auto-generated by DevEco - never commit
# arkui-x.dir, sdk.dir in local.properties

# ── C/C++ native ──────────────────────────────────────────
.cxx/
.clangd/
.clang-format
.clang-tidy
CMakeCache.txt
cmake-build-*/

# ── ArkUI-X cross-platform ────────────────────────────────
# Android (under .arkui-x/android)
.arkui-x/android/.gradle/
.arkui-x/android/build/
.arkui-x/android/app/build/
.arkui-x/android/local.properties
.arkui-x/android/*.iml
gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar

# iOS (under .arkui-x/ios)
.arkui-x/ios/Pods/
.arkui-x/ios/Podfile.lock
.arkui-x/ios/*.xcworkspace
.arkui-x/ios/build/
.arkui-x/ios/DerivedData/
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Keep ArkUI-X config itself
!.arkui-x/arkui-x-config.json5

# ── IDE ───────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/

# DevEco extra
.shelf/
workspace.xml
tasks.xml

# ── OS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Env & secrets ─────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets.json
secrets.yaml

# ── Logs & temp ───────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hvigor-*.log
build-logs/
hs_err_pid*
replay_pid*

# ── Test & coverage ───────────────────────────────────────
coverage/
.nyc_output/
junit.xml
test-results/
screenshots/
*.hprof

# ── Cache ─────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.hvigor/cache/
.hvigor/dependencyMap/

# ── Tooling ───────────────────────────────────────────────
.codegraph/*
!.codegraph/.gitignore
opencode/
.muse/

# ── Misc ──────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
*.stackdump
